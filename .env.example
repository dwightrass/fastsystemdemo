# Je Mollie API-key (test_... voor testen, live_... voor echte betalingen)
# Te vinden in je Mollie Dashboard > Developers > API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publieke URL van je webshop (zonder slash aan het eind).
# Mollie stuurt de klant hierheen terug na betalen en roept hier de webhook aan.
BASE_URL=http://localhost:3000

PORT=3000
